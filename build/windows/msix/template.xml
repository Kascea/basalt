<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="basalt"
        Arguments=""
        InstallLocation="C:\Program Files\Cole Carlson\Basalt">
    </Installer>
    <PackageInformation
        PackageName="Basalt"
        PackageDisplayName="Basalt"
        PublisherName="CN=Cole Carlson"
        PublisherDisplayName="Cole Carlson"
        Version="0.1.0.0"
        PackageDescription="A native database workspace for browsing, querying, and editing rows">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.colecarlson.basalt"
                Description="A native database workspace for browsing, querying, and editing rows"
                DisplayName="Basalt"
                ExecutableName="basalt"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Basalt</DisplayName>
            <PublisherDisplayName>Cole Carlson</PublisherDisplayName>
            <Description>A native database workspace for browsing, querying, and editing rows</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="basalt.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
